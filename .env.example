# Copy to .env for local development. Never commit .env.
# Every variable is RAG_-prefixed and maps to a field in src/insurance_rag/config.py.

RAG_ENV=local
RAG_AWS_REGION=us-east-1

# --- Bedrock (enable model access in the Bedrock console first) --------------------
RAG_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
RAG_LLM_MODEL_ID=us.amazon.nova-lite-v1:0
# Rerank models exist only in some regions; check the console and set accordingly.
RAG_RERANK_REGION=us-west-2
RAG_RERANK_MODEL_ID=amazon.rerank-v1:0

# --- Local dependencies (docker compose up -d opensearch redis) ----------------------
RAG_OPENSEARCH_ENDPOINT=http://localhost:9200
RAG_OPENSEARCH_AUTH=none
RAG_REDIS_URL=redis://localhost:6379
RAG_CACHE_MODE=semantic        # semantic | exact | off

# --- Optional: guardrails (create one with infra/terraform or the console) ------------
# RAG_GUARDRAIL_ID=
# RAG_GUARDRAIL_VERSION=1
# RAG_GUARDRAIL_GROUNDING=true

# --- Optional: Langfuse (self-hosted or cloud) ---------------------------------------
# RAG_LANGFUSE_ENABLED=true
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
